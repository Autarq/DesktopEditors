+def fetch_x265(base_dir):
+  target_dir = os.path.join(base_dir, "x265_git")
+  archive_path = os.path.join(base_dir, f"x265_{X265_VERSION}.tar.gz")
+  archive_urls = base.get_env("EO_X265_ARCHIVE_URLS")
+  if archive_urls == "":
+    archive_urls = " ".join(X265_ARCHIVE_URLS)
+
+  for archive_url in archive_urls.split():
+    if archive_url == "":
+      continue
+    print(f"[fetch]: x265 archive {archive_url}")
+    if 0 != base.cmd("curl", ["-L", "--fail", "--retry", "5", "--retry-delay", "10", "-o", archive_path, archive_url], True):
+      continue
+    try:
+      if base.is_dir(target_dir):
+        base.delete_dir_with_access_error(target_dir)
+      with tarfile.open(archive_path, "r:gz") as archive:
+        archive.extractall(base_dir)
+      extracted_dir = os.path.join(base_dir, f"x265_{X265_VERSION}")
+      if not base.is_dir(extracted_dir):
+        extracted_dir = os.path.join(base_dir, f"x265-{X265_VERSION}")
+      if not base.is_dir(extracted_dir):
+        raise RuntimeError("x265 archive did not contain the expected source directory")
+      os.rename(extracted_dir, target_dir)
+      base.delete_file(archive_path)
+      return
+    except Exception as error:
+      print(f"x265 archive extraction failed: {error}")
+      if base.is_file(archive_path):
+        base.delete_file(archive_path)
+
+  print("[fetch]: x265 git fallback")
+  if 0 == base.cmd("git", ["clone", "--depth", "1", "--branch", f"Release_{X265_VERSION}", "https://bitbucket.org/multicoreware/x265_git.git", "x265_git"], True):
+    return
+
+  sys.exit("Error (x265): unable to fetch x265 source archive or git repository")
+  return
+
